import cv2
import os

# Ask which letter you want to collect
letter = input("Enter the letter (A-Z): ").upper()

# Check that the input is one letter
if len(letter) != 1 or not letter.isalpha():
    print("Please enter only one letter from A to Z.")
    exit()

# Folder where images will be saved
save_folder = os.path.join("dataset", letter)

# Create folder if it doesn't exist
os.makedirs(save_folder, exist_ok=True)

# Start camera
camera = cv2.VideoCapture(0)

if not camera.isOpened():
    print("Camera could not be opened.")
    exit()

count = 0

print()
print("Camera started!")
print("Show your hand inside the camera.")
print("Press SPACE to capture an image.")
print("Press Q to quit.")
print()

while True:

    ret, frame = camera.read()

    if not ret:
        print("Could not read camera.")
        break

    # Mirror the camera
    frame = cv2.flip(frame, 1)

    # Draw a box where you should place your hand
    cv2.rectangle(
        frame,
        (100, 100),
        (500, 400),
        (255, 0, 0),
        2
    )

    # Display instructions
    cv2.putText(
        frame,
        f"Letter: {letter}",
        (20, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0, 255, 0),
        2
    )

    cv2.putText(
        frame,
        f"Images: {count}",
        (20, 80),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 255, 0),
        2
    )

    cv2.putText(
        frame,
        "SPACE = Capture | Q = Quit",
        (20, 450),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (0, 255, 0),
        2
    )

    # Show camera
    cv2.imshow("ASL Image Collection", frame)

    key = cv2.waitKey(1) & 0xFF

    # SPACE = capture
    if key == 32:

        filename = os.path.join(
            save_folder,
            f"{letter}_{count + 1}.jpg"
        )

        cv2.imwrite(filename, frame)

        count += 1

        print(f"Saved: {filename}")

    # Q = quit
    elif key == ord("q"):
        break

camera.release()
cv2.destroyAllWindows()

print()
print(f"Finished!")
print(f"Total images collected for {letter}: {count}")